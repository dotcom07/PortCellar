diff --git a/scgl/Diagnostics.h b/scgl/Diagnostics.h
new file mode 100644
index 0000000..ec02d18
--- /dev/null
+++ b/scgl/Diagnostics.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#ifdef SCGL_DIAGNOSTICS
+#include <windows.h>
+#include <cstdarg>
+#include <cstdio>
+
+static void scgl_log(const char* format, ...) {
+	static FILE* file = nullptr;
+	if (file == nullptr) {
+		CreateDirectoryA("C:\\temp", nullptr);
+		file = fopen("C:\\temp\\scgl-init.log", "a");
+	}
+	if (file == nullptr) return;
+
+	va_list args;
+	va_start(args, format);
+	vfprintf(file, format, args);
+	va_end(args);
+	fputc('\n', file);
+	fflush(file);
+}
+#define SCGL_LOG(...) scgl_log(__VA_ARGS__)
+#define SCGL_GL_ERROR(label) do { unsigned int error = static_cast<unsigned int>(glGetError()); if (error != 0) SCGL_LOG("gl-error call=%s code=%u", label, error); } while (0)
+#else
+#define SCGL_LOG(...) ((void)0)
+#define SCGL_GL_ERROR(label) ((void)0)
+#endif
